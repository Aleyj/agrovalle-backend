# Copiar a .env local; configurar tambien en Environment de Render.
PORT=3000
SUPABASE_URL=
SUPABASE_KEY=
# Perfil de publicacion Render Free. Para pruebas SMTP seleccionar smtp.
EMAIL_PROVIDER=resend
# Unico destinatario autorizado. Con onboarding@resend.dev debe ser el correo de la cuenta Resend.
EMAIL_USER=
# Solo Resend: clave privada y remitente de prueba.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
RESEND_TIMEOUT_MS=15000
# Solo SMTP:
# Gmail requiere una contrasena de aplicacion, no la contrasena normal.
EMAIL_PASS=
# 465 usa TLS directo; 587 usa STARTTLS obligatorio.
# Render Free bloquea ambos puertos. Cambiarlos no evita esa restriccion.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GEMINI_API_KEY=
# Confirmar acceso con: node diagnostico.js --models
GEMINI_MODEL=gemini-3.5-flash-lite
ADMIN_USER=
ADMIN_PASS=
JWT_SECRET=
